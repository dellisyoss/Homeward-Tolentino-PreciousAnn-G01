# Copy to .env. Keep the real values out of Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional additional HTTPS origins for a custom production domain:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Render sets DJANGO_SETTINGS_MODULE=homeward.production through render.yaml.

# Supabase > Connect > Session pooler (port 5432).
# Copy the exact host and username shown for your project.
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
